---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Resonance">
  <div id="home-root"></div>
</AppLayout>

<script>
  import { definePage } from '../lib/ui/page';
  import { library } from '../lib/library/service';
  import { player } from '../lib/player/engine';
  import {
    albumTile, trackTile, sectionHeader, skeletonShelf, emptyState,
  } from '../lib/ui/render';
  import { bindTrackList } from '../lib/ui/track-actions';
  import { logoLockup } from '../lib/ui/logo';
  import type { Track } from '../lib/library/types';

  async function setup() {
    const root = document.getElementById('home-root');
    if (!root) return;

    let recentTracks: Track[] = [];

    await definePage({
      root,
      skeleton: `
        <header class="page-header">${logoLockup()}</header>
        ${skeletonShelf()}
        <div class="h-8"></div>
        ${skeletonShelf()}`,

      load: async () => {
        // Home is three independent shelves: one slow query should not blank
        // the whole screen, so failures degrade to an empty shelf.
        const [recentlyPlayed, recentlyAdded, albums, stats] = await Promise.all([
          library.getRecentlyPlayed(12).catch(() => []),
          library.getRecentlyAdded(12).catch(() => []),
          library.getAlbums({ limit: 12 }).catch(() => ({ items: [], total: 0, hasMore: false })),
          library.getLibraryStats().catch(() => ({ tracks: 0, albums: 0, artists: 0 })),
        ]);

        recentTracks = recentlyPlayed;

        if (stats.tracks === 0) {
          return `
            <header class="page-header">${logoLockup()}</header>
            ${emptyState(
              'Your library is empty',
              'Add some music and it will show up here.',
              { label: 'Add music', href: '/upload' },
            )}`;
        }

        const sections: string[] = [
          `<header class="page-header">
             <div>
               ${logoLockup()}
               <p class="page-subtitle">
                 ${stats.tracks} songs · ${stats.albums} albums · ${stats.artists} artists
               </p>
             </div>
           </header>`,
        ];

        if (recentlyPlayed.length) {
          sections.push(
            `<section class="mb-8">
               ${sectionHeader('Recently played')}
               <div class="shelf">${recentlyPlayed.map(trackTile).join('')}</div>
             </section>`,
          );
        }

        if (recentlyAdded.length) {
          sections.push(
            `<section class="mb-8">
               ${sectionHeader('Recently added', '/library?tab=albums')}
               <div class="shelf">${recentlyAdded.map((a) => albumTile(a)).join('')}</div>
             </section>`,
          );
        }

        if (albums.items.length) {
          sections.push(
            `<section class="mb-8">
               ${sectionHeader('From your library', '/library?tab=albums')}
               <div class="shelf">${albums.items.map((a) => albumTile(a)).join('')}</div>
             </section>`,
          );
        }

        return sections.join('');
      },

      bind: (root) => {
        // The "Recently played" shelf uses tiles, not rows, so it gets its own
        // click handling.
        root.addEventListener('click', (e) => {
          const tile = (e.target as HTMLElement).closest<HTMLElement>('[data-tile-track]');
          if (!tile) return;
          const index = recentTracks.findIndex((t) => t.id === tile.dataset.trackId);
          if (index >= 0) void player.playTracks(recentTracks, { startIndex: index });
        });
        bindTrackList(root, {
          tracks: () => recentTracks,
          onChanged: async () => {
            delete root.dataset.pageInit;
            await setup();
          },
        });
      },
    });
  }

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
