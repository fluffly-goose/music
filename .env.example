# ---------------------------------------------------------------------------
# These variables are ONLY used by the local import script (scripts/import-music.mjs).
# They are never bundled into the website. The browser app asks for its Supabase
# connection details at runtime and stores them in the visitor's own localStorage.
# ---------------------------------------------------------------------------

# Your Supabase project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Service-role key. NEVER put this in a browser, a public repo, or a deployed site.
# It bypasses Row Level Security and is used here only to upload/insert from your machine.
SUPABASE_SERVICE_ROLE_KEY=

# The auth user id (UUID) that should own the imported library.
# Find it in Supabase Dashboard -> Authentication -> Users.
SUPABASE_OWNER_ID=

# Storage bucket that holds audio + artwork.
SUPABASE_BUCKET=music
